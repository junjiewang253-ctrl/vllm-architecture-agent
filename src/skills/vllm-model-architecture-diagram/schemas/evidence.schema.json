{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/vllm-architecture-agent/evidence.schema.json",
  "title": "vLLM Architecture Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "target_file", "source_sha256", "claims"],
  "properties": {
    "schema_version": { "const": "2.1" },
    "target_file": { "type": "string" },
    "source_sha256": { "type": "string" },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "statement",
          "category",
          "phase",
          "confidence",
          "derivation",
          "external_boundary",
          "source_item_ids",
          "evidence",
          "used_in_pages"
        ],
        "properties": {
          "id": { "type": "string" },
          "statement": { "type": "string" },
          "category": { "type": "string" },
          "phase": {
            "enum": ["construction", "runtime", "loading", "parallel", "capability", "external"]
          },
          "confidence": { "enum": ["direct", "derived", "external"] },
          "derivation": { "type": "string" },
          "external_boundary": { "type": "string" },
          "source_item_ids": { "type": "array", "items": { "type": "string" } },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["file", "start_line", "end_line", "symbol", "reason"],
              "properties": {
                "file": { "type": "string" },
                "start_line": { "type": "integer", "minimum": 1 },
                "end_line": { "type": "integer", "minimum": 1 },
                "symbol": { "type": "string" },
                "reason": { "type": "string" }
              }
            }
          },
          "used_in_pages": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
