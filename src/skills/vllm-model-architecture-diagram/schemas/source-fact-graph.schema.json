{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Source Fact Graph",
  "type": "object",
  "required": ["schema_version", "facts", "relations"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "source_analysis_version": { "type": "string" },
    "model_name": { "type": "string" },
    "source_file": { "type": ["string", "null"] },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "summary", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "owner_class": { "type": ["string", "null"] },
          "method": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] },
          "summary": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "source", "target", "relation", "evidence"],
        "properties": {
          "id": { "type": "string" },
          "source": { "type": "string" },
          "target": { "type": "string" },
          "relation": {
            "enum": ["contains", "calls", "constructs", "implements", "depends_on", "loads", "maps_to", "parallelizes", "returns", "branches_to"]
          },
          "evidence": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
