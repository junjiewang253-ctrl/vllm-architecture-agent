{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/vllm/diagram-view.schema.json",
  "title": "vLLM diagram view plan",
  "type": "object",
  "required": ["schema_version", "source_ir_version", "model_name", "pages", "style_profile", "unresolved"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "source_ir_version": {"const": "0.5"},
    "model_name": {"type": "string", "minLength": 1},
    "style_profile": {"type": "string", "minLength": 1},
    "unresolved": {"type": "array", "items": {"type": "object"}},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "page_type", "regions", "lanes", "visible_nodes", "visible_edges", "bundles", "annotations", "layout_constraints"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "page_type": {"type": "string", "minLength": 1},
          "regions": {"type": "array", "items": {"type": "object"}},
          "lanes": {"type": "array", "items": {"type": "object"}},
          "visible_nodes": {"type": "array", "items": {"type": "object"}},
          "visible_edges": {"type": "array", "items": {"type": "object"}},
          "bundles": {"type": "array", "items": {"type": "object"}},
          "annotations": {"type": "array", "items": {"type": "object"}},
          "layout_constraints": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
