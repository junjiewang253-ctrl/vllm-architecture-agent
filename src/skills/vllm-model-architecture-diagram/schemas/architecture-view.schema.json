{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Architecture View Graph",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "view_graph_type",
    "source_design_version",
    "model_name",
    "source_sha256",
    "pages",
    "external_boundaries",
    "legend"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "view_graph_type": { "const": "architecture_view_graph" },
    "source_design_version": { "const": "1.0" },
    "model_name": { "type": "string" },
    "source_sha256": { "type": "string" },
    "pages": { "type": "array" },
    "external_boundaries": { "type": "array" },
    "legend": { "type": "array" }
  }
}
