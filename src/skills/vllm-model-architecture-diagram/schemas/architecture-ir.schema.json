{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/vllm/architecture-ir.schema.json",
  "title": "vLLM architecture diagram IR",
  "type": "object",
  "required": ["schema_version", "model_name", "detail_level", "pages", "unresolved"],
  "properties": {
    "schema_version": {"const": "0.6"},
    "model_name": {"type": "string", "minLength": 1},
    "detail_level": {"enum": ["overview", "full"]},
    "source_analysis_version": {"type": "string"},
    "source_fact_ids": {"type": "array", "items": {"type": "string"}},
    "weight_loading_entrypoints": {"type": "array", "items": {"type": "string"}},
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "page_type", "nodes", "edges"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "page_type": {
            "enum": [
              "overview",
              "decoder_detail",
              "attention_detail",
              "moe_detail",
              "adapter_integration",
              "parallelism",
              "weight_loading"
            ]
          },
          "nodes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "label", "kind", "badges", "evidence"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "label": {"type": "string", "minLength": 1},
                "subtitle": {"type": ["string", "null"]},
                "display": {
                  "type": "object",
                  "properties": {
                    "label": {"type": "string"},
                    "subtitle": {"type": ["string", "null"]},
                    "description": {"type": ["string", "null"]},
                    "show_badges": {"type": "boolean"}
                  },
                  "additionalProperties": false
                },
                "kind": {
                  "enum": [
                    "input",
                    "embedding",
                    "normalization",
                    "attention",
                    "ffn",
                    "moe",
                    "repeated_block",
                    "head",
                    "logits_processor",
                    "decision",
                    "add",
                    "merge",
                    "output",
                    "container",
                    "note"
                  ]
                },
                "phase": {
                  "enum": [
                    "construction",
                    "runtime",
                    "checkpoint_loading",
                    "parallel_partition"
                  ]
                },
                "scope": {"type": ["string", "null"]},
                "parent_id": {"type": ["string", "null"]},
                "badges": {"type": "array", "items": {"type": "string"}},
                "ports": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["id", "label", "direction", "data_kind"],
                    "properties": {
                      "id": {"type": "string", "minLength": 1},
                      "label": {"type": "string", "minLength": 1},
                      "direction": {"enum": ["input", "output", "bidirectional"]},
                      "data_kind": {
                        "enum": ["tensor", "config", "weights", "cache", "capability", "control"]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "repetition": {
                  "type": ["object", "null"],
                  "properties": {
                    "count_expression": {"type": "string"},
                    "local_start": {"type": ["string", "null"]},
                    "local_end": {"type": ["string", "null"]}
                  },
                  "required": ["count_expression"],
                  "additionalProperties": false
                },
                "variants": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["condition", "component", "phase"],
                    "properties": {
                      "condition": {"type": "string", "minLength": 1},
                      "component": {"type": "string", "minLength": 1},
                      "phase": {
                        "enum": [
                          "construction",
                          "runtime",
                          "checkpoint_loading",
                          "parallel_partition"
                        ]
                      }
                    },
                    "additionalProperties": false
                  }
                },
                "evidence": {"type": "array", "items": {"type": "object"}}
              },
              "additionalProperties": true
            }
          },
          "edges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "source", "target", "kind", "evidence"],
              "properties": {
                "id": {"type": "string", "minLength": 1},
                "source": {"type": "string", "minLength": 1},
                "target": {"type": "string", "minLength": 1},
                "kind": {
                  "enum": [
                    "runtime",
                    "residual",
                    "containment",
                    "dependency",
                    "conditional_true",
                    "conditional_false",
                    "weight_mapping",
                    "invocation",
                    "summary",
                    "adaptation",
                    "parallel_partition"
                  ]
                },
                "phase": {
                  "enum": [
                    "construction",
                    "runtime",
                    "checkpoint_loading",
                    "parallel_partition"
                  ]
                },
                "scope": {"type": ["string", "null"]},
                "label": {"type": ["string", "null"]},
                "condition": {"type": ["string", "null"]},
                "source_port": {"type": ["string", "null"]},
                "target_port": {"type": ["string", "null"]},
                "display": {
                  "type": "object",
                  "properties": {
                    "visible": {"type": "boolean"},
                    "show_label": {"type": "boolean"},
                    "route": {
                      "enum": [
                        "direct",
                        "top_lane",
                        "bottom_lane",
                        "horizontal_lane",
                        "vertical_branch",
                        "local_branch",
                        "cache_write",
                        "cache_read",
                        "weight_mapping",
                        "hidden_semantic"
                      ]
                    },
                    "label": {"type": ["string", "null"]}
                  },
                  "additionalProperties": false
                },
                "evidence": {"type": "array", "items": {"type": "object"}}
              },
              "additionalProperties": true
            }
          }
        },
        "additionalProperties": false
      }
    },
    "unresolved": {"type": "array", "items": {"type": "object"}},
    "review": {
      "type": "object",
      "properties": {
        "mode": {"type": "string"},
        "base_ir_sha256": {"type": "string"},
        "patch_sha256": {"type": "string"},
        "applied_operations": {"type": "array", "items": {"type": "string"}},
        "deferred_operations": {"type": "array", "items": {"type": "object"}}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
