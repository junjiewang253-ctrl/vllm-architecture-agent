{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/vllm/source-analysis.schema.json",
  "title": "vLLM source analysis",
  "type": "object",
  "required": [
    "schema_version",
    "source_file",
    "imports",
    "classes",
    "class_attributes",
    "module_assignments",
    "layer_factories",
    "forward_flows",
    "forward_control_flows",
    "conditions",
    "parallelism_hints",
    "weight_loading_hints",
    "weight_mappings",
    "warnings"
  ],
  "properties": {
    "schema_version": {"const": "0.2"},
    "source_file": {"type": "string"},
    "imports": {"type": "array", "items": {"type": "object"}},
    "classes": {"type": "array", "items": {"type": "object"}},
    "class_attributes": {"type": "array", "items": {"type": "object"}},
    "module_assignments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "targets",
          "attribute",
          "constructor",
          "assignment_kind",
          "line",
          "source",
          "owner_class",
          "method"
        ],
        "properties": {
          "targets": {"type": "array", "items": {"type": "string"}},
          "attribute": {"type": ["string", "null"]},
          "constructor": {"type": ["string", "null"]},
          "assignment_kind": {
            "enum": ["submodule", "parameter", "state", "factory_result", "unknown"]
          },
          "line": {"type": ["integer", "null"]},
          "source": {"type": ["string", "null"]},
          "owner_class": {"type": ["string", "null"]},
          "method": {"type": ["string", "null"]}
        },
        "additionalProperties": true
      }
    },
    "layer_factories": {"type": "array", "items": {"type": "object"}},
    "forward_flows": {"type": "array", "items": {"type": "object"}},
    "forward_control_flows": {"type": "array", "items": {"type": "object"}},
    "conditions": {"type": "array", "items": {"type": "object"}},
    "parallelism_hints": {"type": "array", "items": {"type": "object"}},
    "weight_loading_hints": {"type": "array", "items": {"type": "object"}},
    "weight_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "target",
          "shard",
          "mapping_kind",
          "line",
          "context"
        ]
      }
    },
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
