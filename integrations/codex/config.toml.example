# Codex Draw.io MCP 配置示例。
# 如果 `.\tools\setup-mentor.ps1 -ConfigureDrawioMcp` 已成功执行，通常不需要手工复制。
# 手工配置时，把下面片段加入 Codex 的 config.toml，然后重启 VS Code Codex。

[mcp_servers.drawio]
command = "npx"
args = ["-y", "@next-ai-drawio/mcp-server@latest"]
startup_timeout_sec = 30
tool_timeout_sec = 120
enabled = true
